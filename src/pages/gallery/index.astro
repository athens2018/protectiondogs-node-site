---
import Base from '../../layouts/Base.astro';
import Card from '../../components/ui/Card.astro';
import Field from '../../components/ui/Field.astro';
import Button from '../../components/ui/Button.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import { getGallerySection, getDogsSection, recordGalleryMutation, resolveLocaleString } from '../../lib/cms';
import { readAccessToken, setGalleryAccessCookie, accessTokenMatches } from '../../lib/gallery-auth';

// Server-rendered — every visit needs a live lookup against the current
// visitor roster (an approval can happen at any time) and records a view;
// this can never be part of the static build like Dogs/FAQ/Testimonials.
export const prerender = false;

const WHATSAPP_NUMBER = '306931736026';

const token = readAccessToken(Astro.cookies, Astro.url);
const section = await getGallerySection();

const visitorIndex = token ? section.visitors.findIndex((v) => v.status === 'approved' && v.accessTokenHash && accessTokenMatches(token, v.accessTokenHash)) : -1;
const visitor = visitorIndex === -1 ? null : section.visitors[visitorIndex];

let requestStatus: 'none' | 'pending' | 'revoked' = 'none';
if (token && !visitor) {
  const byToken = section.visitors.find((v) => v.accessTokenHash && accessTokenMatches(token, v.accessTokenHash));
  if (byToken?.status === 'revoked') requestStatus = 'revoked';
}

if (visitor && token) {
  // Persist the token as a cookie the first time it arrives via ?token= from
  // the approval email, so later visits don't need the URL at all.
  setGalleryAccessCookie(Astro.cookies, token);

  // Best-effort view recording — never blocks rendering, and losing an
  // occasional increment under a rare write race is fine (see cms.ts's
  // recordGalleryMutation comment).
  const visitorId = visitor.id;
  recordGalleryMutation((current) => ({
    ...current,
    visitors: current.visitors.map((v) => (v.id === visitorId ? { ...v, lastVisitAt: new Date().toISOString(), totalViews: v.totalViews + 1 } : v)),
  })).catch(() => {});
}

const dogsSection = await getDogsSection();
const visitorDogName = visitor?.dogId ? resolveLocaleString(dogsSection.dogs.find((d) => d.id === visitor.dogId)?.name, 'en') : null;

const visibleItems = visitor
  ? [...section.items].filter((i) => i.dogId === null || i.dogId === visitor.dogId).sort((a, b) => new Date(b.uploadedAt).getTime() - new Date(a.uploadedAt).getTime())
  : [];

const dogOptionsForForm = dogsSection.dogs.filter((d) => d.status !== 'placed').map((d) => ({ id: d.id, name: resolveLocaleString(d.name, 'en') }));
---

<Base
  locale="en"
  title="Private Gallery — Protection Dogs GR"
  description="Real training footage, by request only."
  robots="noindex, nofollow"
  manifestHref="/gallery.webmanifest"
>
  <main id="main-content" class="gallery-page">
    {visitor ? (
      <Fragment>
        <div class="gallery-hero">
          <div class="container container--narrow">
            <p class="gallery-hero__eyebrow">Private Gallery</p>
            <h1 class="gallery-hero__heading">Hi {visitor.name}</h1>
            <p class="gallery-hero__sub">
              {visitorDogName ? `Here's the real, day-to-day footage of ${visitorDogName}'s development.` : "Here's the real, day-to-day training footage — not the highlight reel."}
            </p>
          </div>
        </div>

        <div class="container container--wide">
          <div id="gallery-install-banner" class="gallery-install" hidden>
            <p class="gallery-install__text">Get back in with one tap next time.</p>
            <Button id="gallery-install-button" variant="outline" hidden>Add to Home Screen</Button>
            <p id="gallery-install-ios-hint" class="gallery-install__ios-hint" hidden>
              Tap <strong>Share</strong>, then <strong>Add to Home Screen</strong>.
            </p>
          </div>

          {visibleItems.length === 0 ? (
            <p class="gallery-empty">Nothing here yet — check back soon.</p>
          ) : (
            <div class="gallery-grid" data-gallery-grid data-token={token}>
              {visibleItems.map((item) => (
                <Card tone="elevated" interactive padding="md" as="article" class="gallery-item" data-item-id={item.id}>
                  <div class="gallery-item__media">
                    {item.type === 'photo' ? (
                      <img src={item.url} alt={item.caption || 'Training photo'} loading="lazy" />
                    ) : (
                      <video src={item.url} controls preload="metadata" playsinline />
                    )}
                  </div>
                  {item.stage && <p class="gallery-item__stage">{item.stage}</p>}
                  {item.caption && <p class="gallery-item__caption">{item.caption}</p>}
                  <button type="button" class="gallery-interest" data-item-id={item.id}>
                    ♥ Interested <span class="gallery-interest__count">({item.interestCount})</span>
                  </button>
                </Card>
              ))}
            </div>
          )}

          <Card tone="gold" padding="lg" class="gallery-contact">
            <p class="gallery-contact__prompt">Have a question about what you're seeing?</p>
            <a
              id="gallery-contact-link"
              class="btn btn--primary"
              data-token={token}
              href={`https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent("Hi — I've been looking at the private gallery and had a question.")}`}
              target="_blank"
              rel="noopener"
            >
              <span class="btn__label">Contact now on WhatsApp</span>
              <span class="btn__sheen" aria-hidden="true"></span>
            </a>
          </Card>
        </div>
      </Fragment>
    ) : (
      <div class="gallery-hero gallery-hero--request">
        <div class="container container--narrow">
          <SectionHeader eyebrow="Private Gallery" heading="Follow the Real Training" level="h1" align="center" />
          <p class="gallery-hero__sub">
            This is real, unpolished training footage — not curated for social media. Access is by request, so tell
            us a little about yourself and we'll send you a personal link.
          </p>

          {requestStatus === 'revoked' && <p class="gallery-request__notice">That link is no longer active — you're welcome to request access again below.</p>}

          <Card tone="elevated" padding="lg" class="gallery-request-card">
            <form id="gallery-request-form" class="gallery-request-form">
              <input type="text" name="website" style="display:none" tabindex="-1" autocomplete="off" />
              <div class="admin-form-row">
                <Field id="gallery-req-name" name="name" label="Your name" kind="text" required />
                <Field id="gallery-req-email" name="email" label="Your email" kind="email" required />
              </div>
              {dogOptionsForForm.length > 0 && (
                <Field
                  id="gallery-req-dog"
                  name="dogId"
                  label="Is there a specific dog you're interested in?"
                  kind="select"
                  options={[{ value: '', label: '— not sure yet / general interest —', selected: true }, ...dogOptionsForForm.map((d) => ({ value: d.id, label: d.name, selected: false }))]}
                />
              )}
              <Field id="gallery-req-answer" name="qualifyingAnswer" label="What's drawing you to a protection dog right now?" kind="textarea" rows={3} required />
              <Button type="submit" variant="primary" size="lg" block>Request access</Button>
              <p id="gallery-request-status" class="gallery-request-status" role="status" aria-live="polite"></p>
            </form>
          </Card>
        </div>
      </div>
    )}
  </main>
</Base>

<script>
  import { initGalleryPage } from '../../scripts/gallery';
  import { initGalleryInstall } from '../../scripts/gallery-install';
  initGalleryPage();
  initGalleryInstall();
</script>

<style>
  .gallery-page {
    min-height: 60vh;
    padding-bottom: var(--space-8);
  }

  .gallery-hero {
    text-align: center;
    padding-block: var(--space-8) var(--space-7);
    background: linear-gradient(180deg, var(--gold-10), transparent);
    border-bottom: 1px solid var(--line);
    margin-bottom: var(--space-7);
  }

  .gallery-hero--request {
    border-bottom: none;
  }

  .gallery-hero__eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: var(--text-sm);
    color: var(--gold);
    margin-bottom: var(--space-2);
  }

  .gallery-hero__heading {
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    color: var(--text-strong);
  }

  .gallery-hero__sub {
    color: var(--text-muted);
    max-width: 52ch;
    margin-inline: auto;
    margin-top: var(--space-3);
  }

  .gallery-empty {
    text-align: center;
    color: var(--text-muted);
    padding-block: var(--space-6);
  }

  .gallery-install {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
    margin-bottom: var(--space-6);
    border: 1px solid var(--line-gold);
    border-radius: var(--radius-sm);
    background: var(--gold-10);
  }

  .gallery-install__text {
    color: var(--text);
    font-size: var(--text-sm);
    margin: 0;
  }

  .gallery-install__ios-hint {
    color: var(--text-muted);
    font-size: var(--text-sm);
    margin: 0;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-5);
    margin-bottom: var(--space-8);
  }

  .gallery-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .gallery-item__media {
    margin: calc(var(--space-4) * -1) calc(var(--space-4) * -1) 0;
    overflow: hidden;
    border-radius: var(--radius-md) var(--radius-md) 0 0;
  }

  .gallery-item__media img,
  .gallery-item__media video {
    width: 100%;
    display: block;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .gallery-item__stage {
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.7rem;
    color: var(--gold);
  }

  .gallery-item__caption {
    color: var(--text);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
  }

  .gallery-interest {
    align-self: flex-start;
    background: none;
    border: 1px solid var(--line-gold);
    border-radius: var(--radius-sm);
    padding: 0.4rem 0.9rem;
    color: var(--gold);
    cursor: pointer;
    font-size: var(--text-sm);
    transition: background-color var(--dur-base) var(--ease-out);
  }

  .gallery-interest:hover:not([disabled]) {
    background: var(--gold-10);
  }

  .gallery-interest[disabled] {
    opacity: 0.6;
    cursor: default;
  }

  .gallery-contact {
    text-align: center;
    margin-bottom: var(--space-8);
  }

  .gallery-contact__prompt {
    color: var(--text-muted);
    margin-bottom: var(--space-4);
  }

  .gallery-request__notice {
    color: var(--error);
    text-align: center;
  }

  .gallery-request-card {
    max-width: 560px;
    margin: var(--space-6) auto 0;
  }

  .gallery-request-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    text-align: start;
  }

  .gallery-request-status {
    min-height: 1.2em;
    font-size: var(--text-sm);
    color: var(--gold);
    text-align: center;
  }
</style>
