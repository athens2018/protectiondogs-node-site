---
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import Button from '../../../../components/ui/Button.astro';
import Badge from '../../../../components/ui/Badge.astro';
import Card from '../../../../components/ui/Card.astro';
import { checkAdminAccess } from '../../../../lib/admin-auth';
import { getGallerySection, listGalleryHistory } from '../../../../lib/cms';

export const prerender = false;

const access = checkAdminAccess(Astro.cookies);
if (!access.ok) return Astro.redirect('/admin/login/');

const [section, history] = await Promise.all([getGallerySection(), listGalleryHistory()]);
const error = Astro.url.searchParams.get('error');
---

<AdminLayout title="Gallery — History">
  <div class="admin-shell">
    <div class="admin-topbar">
      <h1>Gallery — Version history</h1>
      <div class="admin-topbar__actions">
        <a class="admin-topbar__link" href="/admin/gallery/">&larr; Back to gallery</a>
      </div>
    </div>

    {error && <div class="admin-flash admin-flash--error">{error}</div>}

    <p class="admin-hint">
      Every save (an approval, a new upload, a view being recorded) keeps a snapshot here (last {history.length}
      kept). Restoring here takes effect immediately — the gallery is server-rendered, not part of the static site
      build, so unlike Dogs/FAQ/Testimonials there's no rebuild to wait for.
    </p>

    {history.length === 0 ? (
      <Card padding="lg">
        <p class="admin-hint">No history yet — it starts filling in after the next change.</p>
      </Card>
    ) : (
      <ul class="admin-list">
        {history.map((entry) => {
          const isCurrent = entry.version === section.version;
          return (
            <li>
              <Card padding="md">
                <div class="admin-list-item">
                  <div class="admin-list-item__body">
                    <div class="admin-list-item__name">
                      Version {entry.version} {isCurrent && <Badge variant="solid">current</Badge>}
                    </div>
                    <div class="admin-list-item__meta">{new Date(entry.updatedAt).toLocaleString()}</div>
                  </div>
                  <div class="admin-list-item__actions">
                    {!isCurrent && (
                      <form method="POST" action="/admin/api/gallery/restore/">
                        <input type="hidden" name="version" value={entry.version} />
                        <Button type="submit" variant="outline">Restore this version</Button>
                      </form>
                    )}
                  </div>
                </div>
              </Card>
            </li>
          );
        })}
      </ul>
    )}
  </div>
</AdminLayout>
