---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import Button from '../../../components/ui/Button.astro';
import Badge from '../../../components/ui/Badge.astro';
import Card from '../../../components/ui/Card.astro';
import { checkAdminAccess } from '../../../lib/admin-auth';
import { getDogsSection, countAvailable, resolveLocaleString } from '../../../lib/cms';

export const prerender = false;

const access = checkAdminAccess(Astro.cookies);
if (!access.ok) return Astro.redirect('/admin/login/');

const section = await getDogsSection();
const saved = Astro.url.searchParams.get('saved');
const deployMsg = Astro.url.searchParams.get('deploy');

function orderAfterMove(ids: string[], index: number, dir: -1 | 1): string[] {
  const next = ids.slice();
  const target = index + dir;
  if (target < 0 || target >= next.length) return ids;
  [next[index], next[target]] = [next[target], next[index]];
  return next;
}

const ids = section.dogs.map((d) => d.id);
---

<AdminLayout title="Dogs">
  <div class="admin-shell">
    <div class="admin-topbar">
      <h1>Available Dogs</h1>
      <div class="admin-topbar__actions">
        <span class="admin-hint">{countAvailable(section)} currently available &middot; v{section.version}</span>
        <a class="admin-topbar__link" href="/admin/dogs/history/">History</a>
        <a class="admin-topbar__link" href="/admin/faq/">FAQ</a>
        <a class="admin-topbar__link" href="/admin/testimonials/">Testimonials</a>
        <form method="POST" action="/admin/api/logout/"><button class="admin-topbar__link" type="submit" style="background:none;border:none;cursor:pointer;">Sign out</button></form>
      </div>
    </div>

    {saved === '1' && <div class="admin-flash admin-flash--ok">Saved.</div>}
    {deployMsg === 'skipped' && (
      <div class="admin-flash admin-flash--ok">
        Saved. Ask Claude to finish connecting auto-deploy, or redeploy manually for now — DEPLOY_HOOK_URL isn't set yet, so this save didn't trigger a rebuild by itself.
      </div>
    )}
    {deployMsg === 'failed' && (
      <div class="admin-flash admin-flash--error">
        Saved, but the deploy-hook request itself failed. The content is safe; trigger a rebuild manually for now.
      </div>
    )}

    <div style="margin-bottom: var(--space-6);">
      <Button href="/admin/dogs/new/" variant="primary">+ Add a dog</Button>
    </div>

    <ul class="admin-list">
      {section.dogs.map((dog, i) => {
        const upOrder = orderAfterMove(ids, i, -1);
        const downOrder = orderAfterMove(ids, i, 1);
        return (
          <li>
            <Card padding="md">
              <div class="admin-list-item">
                <div class="admin-order-btns">
                  <form method="POST" action="/admin/api/dogs/save/">
                    <input type="hidden" name="action" value="reorder" />
                    <input type="hidden" name="version" value={section.version} />
                    <input type="hidden" name="order" value={JSON.stringify(upOrder)} />
                    <button type="submit" aria-label="Move up" disabled={i === 0}>&uarr;</button>
                  </form>
                  <form method="POST" action="/admin/api/dogs/save/">
                    <input type="hidden" name="action" value="reorder" />
                    <input type="hidden" name="version" value={section.version} />
                    <input type="hidden" name="order" value={JSON.stringify(downOrder)} />
                    <button type="submit" aria-label="Move down" disabled={i === section.dogs.length - 1}>&darr;</button>
                  </form>
                </div>

                {dog.photo ? (
                  <img class="admin-list-item__photo" src={dog.photo.src} alt="" />
                ) : (
                  <div class="admin-list-item__photo" />
                )}

                <div class="admin-list-item__body">
                  <div class="admin-list-item__name">
                    {resolveLocaleString(dog.name, 'en')}{' '}
                    <Badge variant={dog.status === 'available' ? 'solid' : dog.status === 'future' ? 'outline' : 'muted'}>
                      {dog.status}
                    </Badge>
                  </div>
                  <div class="admin-list-item__meta">id: {dog.id}</div>
                </div>

                <div class="admin-list-item__actions">
                  <Button href={`/admin/dogs/${dog.id}/`} variant="outline" size="md">Edit</Button>
                  {dog.status !== 'placed' ? (
                    <form method="POST" action="/admin/api/dogs/save/">
                      <input type="hidden" name="action" value="setStatus" />
                      <input type="hidden" name="version" value={section.version} />
                      <input type="hidden" name="id" value={dog.id} />
                      <input type="hidden" name="status" value="placed" />
                      <Button type="submit" variant="ghost">Retire</Button>
                    </form>
                  ) : (
                    <form method="POST" action="/admin/api/dogs/save/">
                      <input type="hidden" name="action" value="setStatus" />
                      <input type="hidden" name="version" value={section.version} />
                      <input type="hidden" name="id" value={dog.id} />
                      <input type="hidden" name="status" value="future" />
                      <Button type="submit" variant="ghost">Restore as future</Button>
                    </form>
                  )}
                </div>
              </div>
            </Card>
          </li>
        );
      })}
    </ul>
  </div>
</AdminLayout>
