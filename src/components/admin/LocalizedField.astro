---
// One CMS string field: just the English input. Every other one of the 13
// locales is filled in automatically by Claude (src/lib/translate.ts) when
// the form is saved — see src/pages/admin/api/dogs/save.ts. There is no
// manual per-language UI: the owner only ever writes English, and a
// 12-language grid per field was both wasted space and how raw
// `<!--pdg:...-->` marker syntax could leak into a language field unnoticed.
import Field from '../ui/Field.astro';
import type { LocalizedString } from '../../lib/cms';

interface Props {
  /** Form field name prefix, e.g. "name" or "stats.0.label" */
  name: string;
  label: string;
  value?: LocalizedString;
  kind?: 'text' | 'textarea';
  required?: boolean;
}

const { name, label, value, kind = 'text', required = true } = Astro.props;
---

<Field id={`${name}.en`} name={`${name}.en`} label={label} kind={kind} value={value?.en ?? ''} required={required} rows={kind === 'textarea' ? 3 : undefined} />
