---
import SectionHeader from '../ui/SectionHeader.astro';
import Icon from '../ui/Icon.astro';

interface TimelineItem {
  phase: string;
  number: string;
  /** Raw HTML */
  label: string;
  period: string;
}

interface PhaseFeature {
  /** Font-Awesome class string, e.g. "fas fa-brain" */
  icon: string;
  h4: string;
  p: string;
}

type PhaseMedia =
  | { type: 'video'; ariaLabel: string; poster: string; src: string }
  | { type: 'image'; alt: string; src: string }
  | null;

interface Phase {
  id: string;
  number: string;
  /** Raw HTML */
  badge: string;
  /** Raw HTML */
  title: string;
  timing: string;
  intro: string;
  features: PhaseFeature[];
  media: PhaseMedia;
}

interface Props {
  h2: string;
  intro: string;
  timeline: { ariaLabel: string; items: TimelineItem[] };
  phaseNav: { ariaLabel: string; prevAriaLabel: string; nextAriaLabel: string; status: string };
  phases: Phase[];
}

// content.training has no `eyebrow` key (unlike every other section) — the
// live source's own markup confirms this section skips the eyebrow line.
const { h2, intro, timeline, phaseNav, phases } = Astro.props;

function iconName(fa: string): string {
  return fa.split(' ').find((c) => c.startsWith('fa-'))?.slice(3) ?? 'check-circle';
}
---

<section id="training" class="section section--dark">
  <div class="container">
    <SectionHeader heading={h2} intro={intro} />

    <!-- DOM contract from src/scripts/phases.ts: .timeline-track[role=group]
         > #timelineTrackFill + .timeline-item[data-phase="N"]; phase-nav
         buttons + [data-phase-current]; .phase-content-wrapper >
         .phase-content[id="phase-N"]. -->
    <div class="timeline-track reveal" style="--reveal-delay: 100ms" role="tablist" aria-label={timeline.ariaLabel} tabindex="0">
      <div id="timelineTrackFill" class="timeline-track-fill"></div>
      {timeline.items.map((item, i) => (
        <div
          class:list={['timeline-item', { active: i === 0 }]}
          data-phase={item.phase}
          id={`phase-tab-${item.phase}`}
          role="tab"
          aria-selected={i === 0 ? 'true' : 'false'}
          aria-controls={`phase-${item.phase}`}
          tabindex={i === 0 ? 0 : -1}
        >
          <div class="timeline-number">{item.number}</div>
          <div class="timeline-label" set:html={item.label} />
          <div class="timeline-period">{item.period}</div>
        </div>
      ))}
    </div>

    <div class="phase-nav reveal" style="--reveal-delay: 160ms" role="group" aria-label={phaseNav.ariaLabel}>
      <button type="button" class="phase-nav-btn" data-phase-prev aria-label={phaseNav.prevAriaLabel} disabled>
        <Icon name="chevron-left" size="1rem" />
      </button>
      <p class="phase-nav-status" aria-live="polite" set:html={phaseNav.status} />
      <button type="button" class="phase-nav-btn" data-phase-next aria-label={phaseNav.nextAriaLabel}>
        <Icon name="chevron-right" size="1rem" />
      </button>
    </div>

    <div class="phase-content-wrapper">
      {phases.map((phase, i) => (
        <div
          class:list={['phase-content', { active: i === 0 }]}
          id={phase.id}
          role="tabpanel"
          aria-labelledby={`phase-tab-${i + 1}`}
          tabindex="0"
          hidden={i !== 0}
        >
          <div class="phase-card">
            <div class="phase-header">
              <span class="phase-badge" set:html={phase.badge} />
              <h3 set:html={phase.title} />
              <p class="phase-timing">{phase.timing}</p>
            </div>

            <p class="phase-intro" set:html={phase.intro} />

            <div class="phase-columns">
              <div class="phase-features">
                {phase.features.map((feature) => (
                  <div class="feature-item">
                    <div class="feature-icon">
                      <Icon name={iconName(feature.icon)} />
                    </div>
                    <div class="feature-text">
                      <h4 set:html={feature.h4} />
                      <p set:html={feature.p} />
                    </div>
                  </div>
                ))}
              </div>

              <div class="phase-image-container">
                {phase.media?.type === 'video' && (
                  <video
                    class="wipe-reveal"
                    controls
                    preload="none"
                    muted
                    loop
                    playsinline
                    poster={phase.media.poster}
                    aria-label={phase.media.ariaLabel}
                  >
                    <source src={phase.media.src} type="video/mp4" />
                  </video>
                )}
                {phase.media?.type === 'image' && (
                  <img class="wipe-reveal" src={phase.media.src} alt={phase.media.alt} loading="lazy" decoding="async" />
                )}
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .timeline-track {
    position: relative;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: var(--space-2);
    margin-top: var(--space-6);
    padding-top: var(--space-5);
  }

  .timeline-track:focus-visible {
    outline-offset: 8px;
  }

  .timeline-track-fill {
    position: absolute;
    top: 0;
    inset-inline-start: 0;
    height: 2px;
    width: 0;
    background: linear-gradient(90deg, var(--gold-deep), var(--gold));
    transition: width var(--dur-slow) var(--ease-out);
  }

  .timeline-track::before {
    content: '';
    position: absolute;
    top: 0;
    inset-inline: 0;
    height: 2px;
    background: var(--line);
  }

  .timeline-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    padding: var(--space-3) var(--space-1);
    text-align: center;
    cursor: pointer;
    /* --text-faint fails WCAG AA on this dark surface at this size (~3.6:1,
       needs 4.5:1) — caught by an automated Lighthouse/axe pass. */
    color: var(--text-muted);
    border-radius: var(--radius-sm);
    transition: color var(--dur-base) var(--ease-out);
  }

  .timeline-item:hover {
    color: var(--text);
  }

  .timeline-item.active {
    color: var(--gold);
  }

  .timeline-number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    border: 1px solid currentColor;
    font-family: var(--font-serif);
    font-weight: 700;
  }

  .timeline-item.active .timeline-number {
    background: var(--gold);
    border-color: var(--gold);
    color: var(--text-on-gold);
  }

  .timeline-label {
    font-size: var(--text-xs);
    font-weight: 600;
    max-width: 12ch;
  }

  .timeline-period {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .phase-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-5);
    margin-block: var(--space-6);
  }

  .phase-nav-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    border: 1px solid var(--line-gold);
    color: var(--gold);
    transition: background-color var(--dur-base) var(--ease-out), opacity var(--dur-base) var(--ease-out);
  }

  .phase-nav-btn:hover:not(:disabled) {
    background: var(--gold-10);
  }

  .phase-nav-btn:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }

  .phase-nav-status {
    min-width: 4ch;
    text-align: center;
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    color: var(--text-strong);
  }

  .phase-nav-status :global([data-phase-current]) {
    color: var(--gold);
  }

  .phase-content-wrapper {
    max-width: var(--container-wide);
    margin-inline: auto;
  }

  .phase-content[hidden] {
    display: none;
  }

  .phase-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    padding: clamp(1.75rem, 3vw, 2.75rem);
    background: var(--bg-4);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
  }

  .phase-header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-3);
  }

  .phase-badge {
    display: inline-flex;
    align-items: center;
    padding: 0.35em 0.9em;
    border-radius: var(--radius-pill);
    background: var(--gold-10);
    border: 1px solid var(--line-gold);
    color: var(--gold);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
  }

  .phase-header h3 {
    color: var(--text-strong);
    margin-inline-end: auto;
  }

  .phase-timing {
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  .phase-intro {
    color: var(--text);
    line-height: var(--leading-relaxed);
    max-width: var(--measure);
  }

  .phase-columns {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-6);
    align-items: start;
  }

  .phase-features {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .feature-item {
    display: flex;
    gap: var(--space-4);
  }

  .feature-icon {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: var(--gold-10);
    color: var(--gold);
  }

  .feature-text h4 {
    color: var(--text-strong);
    margin-bottom: 0.25em;
  }

  .feature-text p {
    color: var(--text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    max-width: none;
  }

  .phase-image-container {
    position: relative;
    min-height: 220px;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: linear-gradient(160deg, var(--bg-3), var(--bg-1));
  }

  .phase-image-container img,
  .phase-image-container video {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 220px;
    object-fit: cover;
  }

  /* Wipe reveal: base state is fully visible with no clip, matching this
     project's fail-safe motion rule — the clip only applies once
     html.pdg-anim.pdg-io are both present (see global.css's .reveal
     comment); effects.ts adds .wipe-revealed via IntersectionObserver. */
  html.pdg-anim.pdg-io .wipe-reveal {
    clip-path: inset(0 100% 0 0);
    transition: clip-path var(--dur-reveal) var(--ease-out);
  }

  html.pdg-anim.pdg-io .wipe-reveal.wipe-revealed {
    clip-path: inset(0 0 0 0);
  }

  [dir='rtl'] html.pdg-anim.pdg-io .wipe-reveal {
    clip-path: inset(0 0 0 100%);
  }

  @media (max-width: 991px) {
    .timeline-label {
      display: none;
    }

    .phase-columns {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 576px) {
    .timeline-track {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 0;
    }

    .timeline-number {
      width: 1.75rem;
      height: 1.75rem;
      font-size: var(--text-sm);
    }

    .phase-header h3 {
      margin-inline-end: 0;
    }
  }
</style>
