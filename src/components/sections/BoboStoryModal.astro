---
interface StorySlide {
  slide: string;
  image: string;
  video: string | null;
  /** Raw HTML */
  h4: string;
  /** Raw HTML */
  p: string;
}

interface Props {
  /** Modal target id — sourced from content.dogs.bobo.storyOpen by the page-assembly layer, not part of content.boboStory itself */
  id: string;
  ariaLabelledby: string;
  close: { label: string; ariaLabel: string };
  media: {
    image: { src: string; alt: string };
    video: { ariaLabel: string; poster: string; src: string };
  };
  title: string;
  dotCount: number;
  slides: StorySlide[];
  nav: { prev: string; next: string; jsClose: string; jsNext: string };
}

const { id, ariaLabelledby, close, media, title, dotCount, slides, nav } = Astro.props;
const dots = Array.from({ length: dotCount }, (_, i) => i);
---

<!-- DOM contract from src/scripts/story.ts: .story-modal root with the
     target id, .story-dot / .story-slide (data-slide), .story-photo > img +
     video (both always present, toggled via hidden), [data-story-prev],
     [data-story-next] (data-label-next / data-label-close feed its
     slide-end label swap), [data-story-close]. -->
<div id={id} class="story-modal" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby={ariaLabelledby}>
  <div class="story-modal-backdrop" data-story-close></div>
  <div class="story-modal-content">
    <button type="button" class="story-modal-close" data-story-close aria-label={close.ariaLabel} set:html={close.label} />

    <div class="story-photo">
      <img src={media.image.src} alt={media.image.alt} loading="eager" decoding="async" />
      <video
        muted
        loop
        controls
        preload="none"
        playsinline
        hidden
        aria-label={media.video.ariaLabel}
        poster={media.video.poster}
      >
        <source src={media.video.src} type="video/mp4" />
      </video>
    </div>

    <div class="story-body">
      <h3 id={ariaLabelledby} class="story-title" set:html={title} />

      <div class="story-dots">
        {dots.map((i) => (
          <span
            class:list={['story-dot', { active: i === 0 }]}
            data-slide={i}
            aria-current={i === 0 ? 'step' : 'false'}
          ></span>
        ))}
      </div>

      <div class="story-slides">
        {slides.map((slide, i) => (
          <div
            class:list={['story-slide', { active: i === 0 }]}
            data-slide={slide.slide}
            data-story-image={slide.image}
            data-story-video={slide.video ?? undefined}
          >
            <h4 set:html={slide.h4} />
            <p set:html={slide.p} />
          </div>
        ))}
      </div>

      <div class="story-nav">
        <button type="button" class="story-nav-btn story-nav-btn--prev" data-story-prev set:html={nav.prev} />
        <button
          type="button"
          class="story-nav-btn story-nav-btn--next"
          data-story-next
          data-label-next={nav.jsNext}
          data-label-close={nav.jsClose}
          set:html={nav.next}
        />
      </div>
    </div>
  </div>
</div>

<style>
  .story-modal {
    position: fixed;
    inset: 0;
    z-index: var(--z-modal);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--gutter);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity var(--dur-base) var(--ease-out), visibility 0s linear var(--dur-base);
  }

  /* Not gated by html.pdg-anim.pdg-io: the modal can only ever be opened
     via a JS-driven click/keydown listener (story.ts), so — like Header's
     .lang-drawer — there is no no-JS path where this needs to start
     visible. */
  .story-modal.open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition-delay: 0s;
  }

  .story-modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(8, 8, 8, 0.82);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }

  .story-modal-content {
    position: relative;
    display: flex;
    width: min(920px, 100%);
    max-height: min(720px, 90vh);
    background: var(--bg-elevated);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lift);
    overflow: hidden;
    transform: translateY(16px) scale(0.98);
    transition: transform var(--dur-slow) var(--ease-out);
  }

  .story-modal.open .story-modal-content {
    transform: none;
  }

  .story-modal-close {
    position: absolute;
    inset-block-start: var(--space-3);
    inset-inline-end: var(--space-3);
    z-index: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: rgba(13, 13, 13, 0.55);
    color: var(--text-strong);
    font-size: 1.6rem;
    line-height: 1;
    transition: background-color var(--dur-base) var(--ease-out), color var(--dur-base) var(--ease-out);
  }

  .story-modal-close:hover {
    background: var(--gold);
    color: var(--text-on-gold);
  }

  .story-photo {
    position: relative;
    flex: 0 0 42%;
    background: var(--bg-0);
  }

  .story-photo img,
  .story-photo video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .story-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
    padding: var(--space-7) var(--space-6) var(--space-6);
    overflow-y: auto;
  }

  .story-title {
    color: var(--gold);
    margin-bottom: var(--space-4);
  }

  .story-dots {
    display: flex;
    gap: 0.5rem;
    margin-bottom: var(--space-5);
  }

  .story-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--line-strong);
    cursor: pointer;
    transition: background-color var(--dur-base) var(--ease-out), transform var(--dur-base) var(--ease-out);
  }

  .story-dot.active {
    background: var(--gold);
    transform: scale(1.25);
  }

  .story-slides {
    flex: 1;
  }

  .story-slide h4 {
    color: var(--text-strong);
    margin-bottom: var(--space-3);
  }

  .story-slide p {
    color: var(--text);
    line-height: var(--leading-relaxed);
    max-width: none;
  }

  .story-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-top: var(--space-6);
  }

  .story-nav-btn {
    display: inline-flex;
    align-items: center;
    padding: 0.75em 1.5em;
    border-radius: var(--radius-sm);
    font-weight: 600;
    font-size: var(--text-sm);
    transition: opacity var(--dur-base) var(--ease-out), transform var(--dur-base) var(--ease-out), background-color var(--dur-base) var(--ease-out);
  }

  .story-nav-btn--prev {
    background: transparent;
    border: 1px solid var(--line-gold);
    color: var(--gold);
    opacity: 0;
    pointer-events: none;
    transform: translateX(-4px);
  }

  [dir='rtl'] .story-nav-btn--prev {
    transform: translateX(4px);
  }

  .story-nav-btn--prev.visible {
    opacity: 1;
    pointer-events: auto;
    transform: none;
  }

  .story-nav-btn--prev:hover {
    background: var(--gold-10);
  }

  .story-nav-btn--next {
    margin-inline-start: auto;
    background: var(--gold);
    color: var(--text-on-gold);
  }

  .story-nav-btn--next:hover {
    background: var(--gold-hover);
    transform: translateY(-2px);
  }

  @media (max-width: 767px) {
    .story-modal-content {
      flex-direction: column;
      max-height: min(680px, 92vh);
    }

    .story-photo {
      flex: 0 0 220px;
    }

    .story-body {
      padding: var(--space-6) var(--space-5) var(--space-5);
    }
  }
</style>
