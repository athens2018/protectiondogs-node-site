---
interface Props {
  homeLabel: string;
  homeHref: string;
  current: string;
  ariaLabel?: string;
}

const { homeLabel, homeHref, current, ariaLabel = 'breadcrumb' } = Astro.props;
---

<nav aria-label={ariaLabel} class="container breadcrumb-nav">
  <ol class="breadcrumb" itemscope itemtype="https://schema.org/BreadcrumbList">
    <li class="breadcrumb-item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
      <a href={homeHref} itemprop="item"><span itemprop="name" set:html={homeLabel} /></a>
      <meta itemprop="position" content="1" />
    </li>
    <li class="breadcrumb-item active" aria-current="page" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
      <span itemprop="name" set:html={current} />
      <meta itemprop="position" content="2" />
    </li>
  </ol>
</nav>

<style>
  .breadcrumb-nav {
    padding-top: calc(var(--nav-h) + var(--banner-h) + var(--space-5));
  }

  .breadcrumb {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .breadcrumb-item + .breadcrumb-item::before {
    content: '';
    display: inline-block;
    width: 1.25rem;
    height: 1px;
    margin-inline-end: 0.6rem;
    vertical-align: middle;
    background: var(--line-strong);
  }

  .breadcrumb-item a {
    color: var(--gold);
  }

  .breadcrumb-item.active {
    color: var(--text);
  }
</style>
