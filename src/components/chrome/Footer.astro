---
import Icon from '../ui/Icon.astro';
import { LOCALES, getLocale, localePath } from '../../lib/i18n';

interface Link {
  label: string;
  href: string;
}

interface Social {
  href: string;
  ariaLabel: string;
  icon: 'instagram' | 'whatsapp' | 'envelope';
}

interface Props {
  locale: string;
  brandTitle: string;
  brandBlurb: string;
  quickLinksTitle: string;
  quickLinksAriaLabel: string;
  links: Link[];
  languageTitle: string;
  connectTitle: string;
  social: Social[];
  /** Raw HTML including <span id="copyright-year">…</span> */
  copyright: string;
  subpath?: string;
  /** Standalone pages (e.g. privacy policy) omit the Language column entirely — verified against the live source, which has no footer-lang markup there */
  showLanguage?: boolean;
}

const {
  locale: localeCode,
  brandTitle,
  brandBlurb,
  quickLinksTitle,
  quickLinksAriaLabel,
  links,
  languageTitle,
  connectTitle,
  social,
  copyright,
  subpath = '',
  showLanguage = true,
} = Astro.props;

const locale = getLocale(localeCode);
---

<footer class="footer">
  <div class="container">
    <div class="footer__grid">
      <div class="footer__brand">
        <h3 class="footer__title" set:html={brandTitle} />
        <p class="footer__blurb" set:html={brandBlurb} />
      </div>

      <div>
        <h3 class="footer__title" set:html={quickLinksTitle} />
        <nav aria-label={quickLinksAriaLabel}>
          <ul class="footer__links">
            {links.map((link) => (
              <li>
                <a href={link.href} set:html={link.label} />
              </li>
            ))}
          </ul>
        </nav>
      </div>

      <div>
        {showLanguage && (
          <Fragment>
            <h3 class="footer__title" set:html={languageTitle} />
            <div class="footer-lang-list">
              {LOCALES.map((l) => (
                <a
                  href={localePath(l.code, subpath)}
                  hreflang={l.htmlLang}
                  lang={l.htmlLang}
                  class:list={['footer-lang', { 'footer-lang-active': l.code === locale.code }]}
                  aria-current={l.code === locale.code ? 'true' : undefined}
                >
                  {l.nativeName}
                </a>
              ))}
            </div>
          </Fragment>
        )}

        <h3 class:list={['footer__title', { 'footer__title--spaced': showLanguage }]} set:html={connectTitle} />
        <div class="social-links">
          {social.map((s) => (
            <a href={s.href} aria-label={s.ariaLabel} class="social-link">
              <Icon name={s.icon} size="1.35em" />
            </a>
          ))}
        </div>
      </div>
    </div>

    <div class="footer__bottom">
      <p class="footer__copyright" set:html={copyright} />
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    padding-block: var(--space-9) var(--space-7);
    background: var(--bg-0);
    border-top: 1px solid var(--line);
  }

  .footer::before {
    content: '';
    position: absolute;
    inset-inline: 0;
    top: -1px;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--gold-40), transparent);
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr 1fr;
    gap: var(--space-8) var(--space-7);
  }

  .footer__title {
    margin-bottom: var(--space-4);
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--gold);
  }

  .footer__title--spaced {
    margin-top: var(--space-6);
  }

  .footer__brand .footer__title {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    font-weight: 700;
    letter-spacing: var(--tracking-tight);
    text-transform: none;
    color: var(--text-strong);
  }

  .footer__blurb {
    max-width: 34ch;
    color: var(--text-muted);
    line-height: var(--leading-relaxed);
  }

  .footer__links {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .footer__links a {
    color: var(--text);
    transition: color var(--dur-fast) var(--ease-out);
  }

  .footer__links a:hover {
    color: var(--gold);
  }

  .footer-lang-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1rem;
  }

  .footer-lang {
    font-size: var(--text-sm);
    color: var(--text-muted);
    transition: color var(--dur-fast) var(--ease-out);
  }

  .footer-lang:hover {
    color: var(--text-strong);
  }

  .footer-lang-active {
    color: var(--gold);
    font-weight: 600;
  }

  .social-links {
    display: flex;
    gap: var(--space-3);
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    color: var(--text);
    transition:
      color var(--dur-base) var(--ease-out),
      border-color var(--dur-base) var(--ease-out),
      background-color var(--dur-base) var(--ease-out);
  }

  .social-link:hover,
  .social-link:focus-visible {
    color: var(--gold);
    border-color: var(--gold);
    background: var(--gold-10);
  }

  .footer__bottom {
    margin-top: var(--space-8);
    padding-top: var(--space-5);
    border-top: 1px solid var(--line);
    text-align: center;
  }

  .footer__copyright {
    margin-inline: auto;
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  @media (max-width: 991px) {
    .footer__grid {
      grid-template-columns: 1fr 1fr;
    }

    .footer__brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 576px) {
    .footer__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
