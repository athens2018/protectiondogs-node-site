---
import type { HTMLAttributes } from 'astro/types';

// Hand-drawn 24×24 stroke icons on currentColor. No icon font, no CDN.
const ICONS: Record<string, { paths: string; filled?: boolean }> = {
  globe: {
    paths:
      '<circle cx="12" cy="12" r="9.5"/><path d="M2.5 12h19M12 2.5c2.8 3 4.2 6.2 4.2 9.5S14.8 18.5 12 21.5M12 2.5c-2.8 3-4.2 6.2-4.2 9.5S9.2 18.5 12 21.5"/>',
  },
  'chevron-down': { paths: '<path d="m6 9 6 6 6-6"/>' },
  'chevron-left': { paths: '<path d="m15 6-6 6 6 6"/>' },
  'chevron-right': { paths: '<path d="m9 6 6 6-6 6"/>' },
  'arrow-up': { paths: '<path d="M12 20V4m0 0-7 7m7-7 7 7"/>' },
  'arrow-right': { paths: '<path d="M4 12h16m0 0-7-7m7 7-7 7"/>' },
  'arrow-down': { paths: '<path d="M12 4v16m0 0 7-7m-7 7-7-7"/>' },
  close: { paths: '<path d="M6 6l12 12M18 6 6 18"/>' },
  check: { paths: '<path d="m5 12.5 4.5 4.5L19 7.5"/>' },
  play: { paths: '<path d="M7 5.5v13l11-6.5z"/>', filled: true },
  envelope: {
    paths: '<rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="m3.5 7 8.5 6.5L20.5 7"/>',
  },
  phone: {
    paths:
      '<path d="M5.5 3.5h3.2l1.6 4.2-2.1 1.6a12.5 12.5 0 0 0 6.5 6.5l1.6-2.1 4.2 1.6v3.2a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 3.5 5.7a2 2 0 0 1 2-2.2z"/>',
  },
  whatsapp: {
    paths:
      '<path d="M4 20.5l1.3-4.1A8.5 8.5 0 1 1 8.4 19.3z"/><path d="M9.2 8.6c.2-.5.5-.5.8-.5h.5c.2 0 .4.1.5.4l.7 1.7c.1.2 0 .4-.1.6l-.5.6c-.1.1-.2.3-.1.5a6.6 6.6 0 0 0 3.2 3.1c.2.1.4 0 .5-.1l.6-.7c.2-.2.4-.2.6-.1l1.7.8c.2.1.4.2.4.4 0 .5-.1 1.1-.5 1.5-.5.5-1.3.8-2 .7A9.4 9.4 0 0 1 8.5 11c-.2-.9 0-1.8.7-2.4z"/>',
  },
  instagram: {
    paths:
      '<rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="3.8"/><circle cx="17" cy="7" r=".9" fill="currentColor" stroke="none"/>',
  },
  lock: {
    paths: '<rect x="5" y="10.5" width="14" height="10" rx="2.5"/><path d="M8 10.5V7.5a4 4 0 0 1 8 0v3"/>',
  },
  'user-lock': {
    paths:
      '<circle cx="9.5" cy="8" r="3.5"/><path d="M3.5 20a6 6 0 0 1 9-5.2"/><rect x="14" y="14" width="7" height="6" rx="1.5"/><path d="M15.5 14v-1.5a2 2 0 0 1 4 0V14"/>',
  },
  'user-secret': {
    paths:
      '<path d="M7.5 10.5c0-3 2-5.5 4.5-5.5s4.5 2.5 4.5 5.5"/><path d="M4 11h16M6.5 11c0 3.3 2.5 5.5 5.5 5.5s5.5-2.2 5.5-5.5"/><path d="M4.5 21a7.5 7.5 0 0 1 15 0"/>',
  },
  clock: { paths: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/>' },
  'external-link': {
    paths: '<path d="M14 4h6v6M20 4l-9 9"/><path d="M19 13.5V18a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h4.5"/>',
  },
  'book-open': {
    paths: '<path d="M12 6.5c-1.8-1.5-4.4-2-8-2v14c3.6 0 6.2.5 8 2 1.8-1.5 4.4-2 8-2v-14c-3.6 0-6.2.5-8 2z"/><path d="M12 6.5v14"/>',
  },
  shield: {
    paths: '<path d="M12 3 4.5 6v5.5c0 4.5 3.2 8 7.5 9.5 4.3-1.5 7.5-5 7.5-9.5V6z"/><path d="m9 12 2 2 4-4"/>',
  },
  paw: {
    paths:
      '<ellipse cx="7" cy="9" rx="1.8" ry="2.4"/><ellipse cx="17" cy="9" rx="1.8" ry="2.4"/><ellipse cx="10.2" cy="5.5" rx="1.7" ry="2.3"/><ellipse cx="13.8" cy="5.5" rx="1.7" ry="2.3"/><path d="M12 11c2.8 0 5.2 2.3 5.2 4.6 0 1.7-1.2 2.9-2.8 2.9-.9 0-1.6-.5-2.4-.5s-1.5.5-2.4.5c-1.6 0-2.8-1.2-2.8-2.9C6.8 13.3 9.2 11 12 11z"/>',
  },
  menu: { paths: '<path d="M4 7h16M4 12h16M4 17h16"/>' },
  minus: { paths: '<path d="M6 12h12"/>' },
  plus: { paths: '<path d="M12 6v12M6 12h12"/>' },
  pause: { paths: '<path d="M8 5.5v13M16 5.5v13"/>' },
  quote: {
    paths:
      '<path d="M6.5 10.5c0-3 1.8-5 4.5-5.5v2c-1.4.4-2.2 1.3-2.4 2.5H10a1 1 0 0 1 1 1V15a1 1 0 0 1-1 1H7.5a1 1 0 0 1-1-1zM14 10.5c0-3 1.8-5 4.5-5.5v2c-1.4.4-2.2 1.3-2.4 2.5h1.4a1 1 0 0 1 1 1V15a1 1 0 0 1-1 1H15a1 1 0 0 1-1-1z"/>',
  },
};

interface Props extends HTMLAttributes<'svg'> {
  name: keyof typeof ICONS | string;
  size?: number | string;
  title?: string;
}

const { name, size = '1em', title, class: className, ...rest } = Astro.props;
const icon = ICONS[name];
if (!icon) throw new Error(`Unknown icon: ${name}`);
const dimension = typeof size === 'number' ? `${size}px` : size;
---

<svg
  class:list={['icon', className]}
  width={dimension}
  height={dimension}
  viewBox="0 0 24 24"
  fill={icon.filled ? 'currentColor' : 'none'}
  stroke={icon.filled ? 'none' : 'currentColor'}
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={title ? undefined : 'true'}
  role={title ? 'img' : undefined}
  focusable="false"
  {...rest}
>
  {title && <title>{title}</title>}
  <Fragment set:html={icon.paths} />
</svg>

<style>
  .icon {
    display: inline-block;
    flex-shrink: 0;
    vertical-align: -0.15em;
  }
</style>
