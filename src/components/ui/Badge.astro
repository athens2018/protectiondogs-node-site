---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'span'> {
  variant?: 'solid' | 'outline' | 'muted';
  /** Raw HTML (may contain &middot; etc.) */
  html?: string;
}

const { variant = 'outline', html, class: className, ...rest } = Astro.props;
---

<span class:list={['badge', `badge--${variant}`, className]} {...rest}>
  {html ? <Fragment set:html={html} /> : <slot />}
</span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    padding: 0.42em 0.9em;
    border-radius: var(--radius-pill);
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1.2;
    white-space: nowrap;
  }

  .badge--solid {
    background: var(--gold);
    color: var(--text-on-gold);
  }

  .badge--outline {
    color: var(--gold);
    border: 1px solid var(--line-gold);
    background: var(--gold-10);
  }

  .badge--muted {
    color: var(--text-muted);
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.03);
  }

  .badge--solid::before {
    content: '';
    width: 0.45em;
    height: 0.45em;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.7;
  }
</style>
