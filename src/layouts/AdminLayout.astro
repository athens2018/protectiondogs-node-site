---
// Minimal shell for the admin/CMS panel — a back-office tool, not a public
// marketing page, so it deliberately does NOT reuse Base.astro (which
// pulls in the full marketing chrome: hreflang alternates, the language
// drawer, the reveal-on-scroll bundle, the service-worker/app-mode
// script, JSON-LD, etc. — none of it relevant here). It DOES reuse the
// same design tokens and global reset (src/styles/global.css, which
// itself imports tokens.css) plus the same UI components elsewhere, so
// this doesn't look like a bolted-on foreign app.
import '@fontsource-variable/inter';
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} — Admin</title>
  </head>
  <body class="admin-body">
    <slot />
  </body>
</html>

<style is:global>
  .admin-body {
    min-height: 100dvh;
    background: var(--bg-1);
  }

  .admin-shell {
    max-width: 960px;
    margin-inline: auto;
    padding: var(--space-6) var(--gutter) var(--space-9);
  }

  .admin-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-4);
    padding-block: var(--space-5);
    margin-bottom: var(--space-6);
    border-bottom: 1px solid var(--line);
  }

  .admin-topbar h1 {
    font-size: var(--text-xl);
    color: var(--gold);
    /* Without this, a growing .admin-topbar__actions list (now up to six
       links) squeezes this flex item down to almost nothing on a narrow
       phone screen instead of wrapping onto its own line below —
       "Available Dogs" was rendering one letter per line. */
    flex-shrink: 0;
  }

  .admin-topbar__actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .admin-topbar__link {
    color: var(--text-muted);
    font-size: var(--text-sm);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .admin-topbar__link:hover {
    color: var(--gold);
  }

  .admin-flash {
    padding: var(--space-4) var(--space-5);
    margin-bottom: var(--space-5);
    border-radius: var(--radius-sm);
    border: 1px solid var(--line);
    font-size: var(--text-sm);
  }

  .admin-flash--error {
    border-color: var(--error);
    color: var(--error);
    background: rgba(255, 107, 107, 0.08);
  }

  .admin-flash--ok {
    border-color: var(--ok);
    color: var(--ok);
    background: rgba(76, 175, 80, 0.08);
  }

  .admin-form-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .admin-form-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--space-4);
  }

  .admin-section-title {
    font-size: var(--text-lg);
    color: var(--gold);
    margin-block: var(--space-2);
  }

  .admin-hint {
    font-size: var(--text-xs);
    color: var(--text-faint);
  }

  .admin-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .admin-list-item {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
  }

  .admin-list-item__photo {
    width: 3.5rem;
    height: 3.5rem;
    border-radius: var(--radius-sm);
    object-fit: cover;
    background: var(--bg-2);
    flex-shrink: 0;
  }

  .admin-list-item__body {
    flex: 1;
    min-width: 0;
  }

  .admin-list-item__name {
    font-weight: 600;
    color: var(--text-strong);
  }

  .admin-list-item__meta {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .admin-list-item__actions {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .admin-order-btns {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .admin-order-btns button {
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 4px;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
  }

  .admin-order-btns button:hover {
    color: var(--gold);
    border-color: var(--line-gold);
  }

  .slide-editor {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-4);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
  }
</style>
