# Copy to .env.local for local development. Never commit a real .env file.
# In production every value lives in Vercel's environment variables
# (`vercel env add <NAME> production --scope pdg3`), never in the repo.

# --- Enquiry form (src/pages/api/enquiry.ts) ---
# A Resend API key restricted to "Sending access" for protectiondogs.gr.
RESEND_API_KEY=""

# --- Instagram feed (src/pages/api/cron/instagram.ts, src/pages/api/instagram/index.ts) ---
# Long-lived Instagram User access token (60-day) from a Meta Developer App
# using "Instagram API with Instagram Login" for the @protectiondogsgr
# Professional account. Only the SEED token: the cron refreshes it and keeps
# the newest one in the private Blob store from then on.
INSTAGRAM_ACCESS_TOKEN=""
# Added automatically when a Vercel Blob store is connected to the project.
# Holds the cached feed (public) and the refreshed token (private).
BLOB_READ_WRITE_TOKEN=""
# Any long random string. Vercel sends it as `Authorization: Bearer …` when it
# invokes the cron route; the route rejects everything else.
CRON_SECRET=""

# --- Dogs CMS / admin panel (src/lib/cms.ts, src/pages/admin/**) ---
# Read/write token for the SEPARATE "pdg-cms" Blob store (kept apart from
# pdg-site-cache above, which is Instagram-only) — deliberately not the
# ambient BLOB_READ_WRITE_TOKEN name, since that's already claimed by the
# Instagram store's connection to this same project. Populated once the
# pdg-cms store is connected to node-site in the Vercel dashboard (Storage
# → pdg-cms → Connect Project); rename the variable it creates to this
# name if the dashboard doesn't let you pick the name directly.
CMS_BLOB_READ_WRITE_TOKEN=""
# "<saltHex>:<keyHex>" produced by Node's built-in scrypt. Generate with:
#   node -e "const c=require('crypto');const s=c.randomBytes(16).toString('hex');const k=c.scryptSync(process.argv[1],s,64).toString('hex');console.log(s+':'+k)" "the-real-password"
ADMIN_PASSWORD_HASH=""
# Any long random string, used to HMAC-sign the admin session cookie.
ADMIN_SESSION_SECRET=""
# Optional. A Vercel Deploy Hook URL — saving the Dogs CMS POSTs to this to
# trigger a rebuild. If unset, saves still succeed; the admin panel just
# shows a reminder that auto-deploy isn't wired up yet.
DEPLOY_HOOK_URL=""
