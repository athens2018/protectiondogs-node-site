# Copy to .env.local for local development. Never commit a real .env file.
# In production every value lives in Vercel's environment variables
# (`vercel env add <NAME> production --scope pdg3`), never in the repo.

# --- Enquiry form (src/pages/api/enquiry.ts) ---
# A Resend API key restricted to "Sending access" for protectiondogs.gr.
RESEND_API_KEY=""

# --- Instagram feed (src/pages/api/cron/instagram.ts, src/pages/api/instagram/index.ts) ---
# Long-lived Instagram User access token (60-day) from a Meta Developer App
# using "Instagram API with Instagram Login" for the @protectiondogsgr
# Professional account. Only the SEED token: the cron refreshes it and keeps
# the newest one in the private Blob store from then on.
INSTAGRAM_ACCESS_TOKEN=""
# Added automatically when a Vercel Blob store is connected to the project.
# Holds the cached feed (public) and the refreshed token (private).
BLOB_READ_WRITE_TOKEN=""
# Any long random string. Vercel sends it as `Authorization: Bearer …` when it
# invokes the cron route; the route rejects everything else.
CRON_SECRET=""
